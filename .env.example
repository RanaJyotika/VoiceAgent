# Copy to .env and fill in. Never commit .env.

# Google AI Studio key (works for Gemini Live and normal Gemini models)
GOOGLE_GEMINI_LIVE_API=

# Your mobile number for test calls, E.164 format, e.g. +919876543210
PHONE_NUMBER=

# Optional overrides
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# GEMINI_VOICE=Aoede
# AGENT_NAME=Priya
# BUSINESS_NAME=Vedic Vaibhav

# --- Plivo phone line (needed only for real phone calls) ---
# PLIVO_AUTH_ID=
# PLIVO_AUTH_TOKEN=
# PLIVO_FROM_NUMBER=+91xxxxxxxxxx        # the number you rent inside Plivo
# PUBLIC_BASE_URL=https://xxxx.trycloudflare.com   # public address of this server
# DIAL_ONLY_MY_NUMBER=true               # safety: all calls go to PHONE_NUMBER above
# MAX_CALL_SECONDS=240                   # hard cap per call so a stuck call cannot run up a bill
