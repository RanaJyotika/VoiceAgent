# Copy to .env and fill in. Never commit .env.

# Google API key for Gemini (AI Studio "AIza..." or Google Cloud "AQ...." format both work)
GOOGLE_GEMINI_LIVE_API=
# GEMINI_VERTEX=true                     # send the key to Vertex AI express mode instead (set GEMINI_LIVE_MODEL too)
# USD_INR=90                             # exchange rate for the cost column on the dashboard

# Your mobile number for test calls, E.164 format, e.g. +919876543210
PHONE_NUMBER=

# Optional overrides
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# GEMINI_VOICE=Aoede
# AGENT_NAME=Gauri
# BUSINESS_NAME=Vedic Vaibhav

# --- Plivo phone line (needed only for real phone calls) ---
# PLIVO_AUTH_ID=
# PLIVO_AUTH_TOKEN=
# PLIVO_FROM_NUMBER=+91xxxxxxxxxx        # the number you rent inside Plivo
# PUBLIC_BASE_URL=https://xxxx.trycloudflare.com   # public address of this server
# DIAL_ONLY_MY_NUMBER=true               # safety: all calls go to PHONE_NUMBER above
# MAX_CALL_SECONDS=240                   # hard cap per call so a stuck call cannot run up a bill
# MAX_CONCURRENT_CALLS=10                # most calls the campaign may run at the same time
# PHONE_END_SILENCE_MS=900               # pause that ends the customer's sentence
# PHONE_LONG_ANSWER_MS=1800              # ...after a question that expects an address or a number
# PHONE_VAD=manual                       # manual = we detect speech; auto = let Gemini decide turn ends (trial)
# PHONE_STUCK_SECONDS=8                  # loud line but nothing understood for this long -> agent repeats the question
# PHONE_SILENT_SECONDS=12                # quiet line for this long -> agent asks "awaaz aa rahi hai?"
# PHONE_RECORD=true                      # save the customer's audio to data/recordings/call_<id>.wav
# FILLERS=true                           # play a short "hmm"/"achha" while Gemini prepares its reply
# FILLER_GENERATE=true                   # make those clips once per voice with Gemini text-to-speech (a few paise)
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# --- OpenAI Realtime (fallback voice agent; optional) ---
# OPENAI_API_KEY=sk-...                  # without this the fallback stays off
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini   # gpt-realtime-2.1 is ~4x the cost per call
# OPENAI_TRANSCRIBE_MODEL=whisper-1      # writes the customer's words; the call guards read it
# OPENAI_FALLBACK=true                   # switch to OpenAI when Gemini cannot take the call
# PROVIDER_COOLDOWN_SECONDS=900          # after that, later calls skip Gemini for this long
