# Copy to .env and fill in. Never commit .env.

# Google API key for Gemini (AI Studio "AIza..." or Google Cloud "AQ...." format both work)
GOOGLE_GEMINI_LIVE_API=
# GEMINI_VERTEX=true                     # send the key to Vertex AI express mode instead (set GEMINI_LIVE_MODEL too)
# USD_INR=90                             # exchange rate for the cost column on the dashboard

# Your mobile number for test calls, E.164 format, e.g. +919876543210
PHONE_NUMBER=

# Optional overrides
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# GEMINI_VOICE=Aoede
# AGENT_NAME=Gauri
# BUSINESS_NAME=Vedic Vaibhav

# --- Plivo phone line (needed only for real phone calls) ---
# PLIVO_AUTH_ID=
# PLIVO_AUTH_TOKEN=
# PLIVO_FROM_NUMBER=+91xxxxxxxxxx        # the number you rent inside Plivo
# PUBLIC_BASE_URL=https://xxxx.trycloudflare.com   # public address of this server
# DIAL_ONLY_MY_NUMBER=true               # safety: all calls go to PHONE_NUMBER above
# MAX_CALL_SECONDS=240                   # hard cap per call so a stuck call cannot run up a bill
# RING_SECONDS=25                        # how long the phone rings before Plivo gives up
# MAX_CONCURRENT_CALLS=10                # most calls the campaign may run at the same time
# PHONE_END_SILENCE_MS=900               # pause that ends the customer's sentence
# PHONE_LONG_ANSWER_MS=1800              # ...after a question that expects an address or a number
# PHONE_VAD=manual                       # manual = we detect speech; auto = let Gemini decide turn ends (trial)
# PHONE_STUCK_SECONDS=8                  # loud line but nothing understood for this long -> agent repeats the question
# PHONE_SILENT_SECONDS=12                # quiet line for this long -> agent asks "awaaz aa rahi hai?"
# PHONE_RECORD=true                      # save the customer's audio to data/recordings/call_<id>.wav
# FILLERS=true                           # play a short "hmm"/"achha" while Gemini prepares its reply
# FILLER_GENERATE=true                   # make those clips once per voice with Gemini text-to-speech (a few paise)
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# --- OpenAI Realtime (fallback voice agent; optional) ---
# OPENAI_API_KEY=sk-...                  # without this the fallback stays off
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini   # gpt-realtime-2.1 is ~4x the cost per call
# OPENAI_TRANSCRIBE_MODEL=whisper-1      # writes the customer's words; the call guards read it
# OPENAI_TRANSCRIBE_LANGUAGE=hi          # force one language; empty lets it detect (safer)
# OPENAI_FALLBACK=true                   # switch to OpenAI when Gemini cannot take the call
# PROVIDER_COOLDOWN_SECONDS=900          # after that, later calls skip Gemini for this long

# --- Shopify (orders and abandoned carts call on their own; see app/shopify.py) ---
# Make an app in Shopify's Dev Dashboard, give it read_orders, write_orders and read_checkouts
# (plus protected customer data: name, phone, address), install it on the store, then:
# SHOPIFY_STORE=yourstore.myshopify.com
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=                 # also checks every webhook is really from Shopify
# SHOPIFY_WEBHOOK_SECRET=                # only for webhooks made by hand in Shopify admin > Notifications
# SHOPIFY_ADMIN_TOKEN=                   # only for an old admin-made app with a fixed shpat_ token

# --- Other systems adding contacts (POST /api/intake/{campaign_id}), e.g. the Vedic Vaibhav main DB ---
# INTAKE_API_KEY=                        # a long random string; sent in the X-Api-Key header

# --- Product catalogue from the Vedic Vaibhav MongoDB (app/catalog.py); read only ---
# Atlas: Database Access > add a user with the built-in role "read" on VV-Ecom only;
# Network Access > add this PC's IP. Then copy the connection string here:
# MONGODB_URI=mongodb+srv://voiceagent-readonly:<password>@<cluster>.mongodb.net/
# MONGODB_DB=VV-Ecom
# MONGODB_PRODUCTS=                      # the products collection; empty = the one named like "product"
# MONGODB_SHOP=q7fssx-1a.myshopify.com   # only this store's products, if the database holds several
# Every finished call is copied to this database and collection (app/mongo_sync.py). Both must already
# exist on the cluster in MONGODB_URI; nothing is written otherwise. Empty = no copying.
# MONGODB_CALLS_DB=ai-calling
# MONGODB_CALLS_COLLECTION=calling

# --- Coupon messages (app/coupons.py, app/messaging.py) ---
# Coupon codes are added on the dashboard (Coupons page) or sent by another system (POST /api/intake/coupons
# with the X-Api-Key above). A customer who says yes to the coupon on an abandoned-cart call gets the code and
# their product in a message. Until MESSAGE_PROVIDER is set nothing is sent: the messages wait on the Coupons
# page, where a person can send them by hand (Open in WhatsApp, then Mark as sent).
# STORE_URL=https://vedicshop.store      # the store, for the link when the cart has no link of its own
# MESSAGE_PROVIDER=                      # whatsapp, plivo_sms or webhook; empty = nothing is sent
# MESSAGE_FROM_NUMBER=                   # SMS sender (number or DLT sender id); empty = PLIVO_FROM_NUMBER
# MESSAGE_MAX_AGE_HOURS=24               # older than this when the service is ready: held for a person, not sent
# MESSAGE_RETRIES=3                      # tries while the service is down or busy, then the message is marked failed
# MESSAGE_SMS_TEMPLATE=                  # the SMS text exactly as registered on DLT, with {name} {product} {offer} {code} {link} {store}
# WhatsApp Cloud API (Meta app > WhatsApp > API setup):
# WHATSAPP_TOKEN=                        # a permanent System User token with whatsapp_business_messaging
# WHATSAPP_PHONE_NUMBER_ID=              # the sending number's "Phone number ID", not the number itself
# WHATSAPP_TEMPLATE=                     # an approved template's name; without it only customers who wrote to you in 24 h get it
# WHATSAPP_TEMPLATE_LANGUAGE=en          # the template's language code as approved (en, en_US, hi...)
# WHATSAPP_TEMPLATE_PARAMS=name,product,offer,code,link   # what fills {{1}}, {{2}}... in that order
# WHATSAPP_API_VERSION=v23.0
# Suggested template body to get approved by Meta (Marketing), its five values in the order above:
#   Namaste {{1}}, aapke Vedic Shop cart mein {{2}} aapka intezaar kar raha hai. 🎁 {{3}}, coupon code {{4}}. Order karein: {{5}}
# Plivo SMS to Indian numbers needs a DLT registration (entity, sender id, template):
# PLIVO_DLT_ENTITY_ID=
# PLIVO_DLT_TEMPLATE_ID=
# PLIVO_DLT_TEMPLATE_CATEGORY=           # the category the template is registered under, e.g. promotional
# Another system sends the messages: each one is POSTed to this address as JSON
# MESSAGE_WEBHOOK_URL=
# MESSAGE_WEBHOOK_TOKEN=                 # sent as "Authorization: Bearer <token>"

# Call recordings to Google Drive with no API: the folder as Google Drive for desktop shows it on this computer.
# GDRIVE_LOCAL_DIR=G:\My Drive\Call Recordings
